# Aster Institute - Environment Variables Template

# ==========================================
# SERVER CONFIGURATION (server/.env)
# ==========================================
PORT=8080
NODE_ENV=development
DATABASE_KEY=mongodb+srv://<username>:<password>@cluster0.mongodb.net/studentMangement
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
JWT_PRIVATE=your_jwt_secret_key_here
COOKIE_SECURE=false

# ==========================================
# CLIENT CONFIGURATION (client/.env)
# ==========================================
VITE_API_URL=/api
